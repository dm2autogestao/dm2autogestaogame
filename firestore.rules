rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isMaster() {
      return signedIn() && profile().role == "master";
    }

    function isFranchisee(unitId) {
      return signedIn() && profile().role == "franchisee" && profile().unitId == unitId;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isMaster());
      allow create: if signedIn() && request.auth.uid == userId && request.resource.data.role == "franchisee";
      allow update: if signedIn() && (request.auth.uid == userId || isMaster());
      allow delete: if isMaster();
    }

    match /units/{unitId} {
      allow read: if isMaster() || isFranchisee(unitId);
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.status == "pending";
      allow update, delete: if isMaster() || isFranchisee(unitId);

      match /campaigns/{campaignId} {
        allow read: if isMaster() || isFranchisee(unitId);
        allow create, update, delete: if isMaster() || isFranchisee(unitId);
      }

      match /progress/{docId} {
        allow read, write: if isMaster() || isFranchisee(unitId);
      }

      match /management/{docId} {
        allow read, write: if isMaster() || isFranchisee(unitId);
      }

      match /commercialInputs/{docId} {
        allow read, write: if isMaster() || isFranchisee(unitId);
      }
    }
  }
}
